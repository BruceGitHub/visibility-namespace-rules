{
  "name": "brucegithub/visibility-namespace-rules",
  "description": "PHPStan rules for namespace-scoped visibility (private namespaces, C#-style internal).",
  "type": "phpstan-extension",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "phpstan/phpstan": "^1.11 || ^2.0"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "BruceGitHub\\VisibilityNamespaceRules\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.2.99"
    }
  },
  "extra": {
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  }
}
